# Bluetooth LE on NimBLE, for the `ble` feature (NB-110), on top of sdkconfig.defaults:
# LE only, no Classic and no Bluedroid. Peers authenticate with Noise IK, so nothing is
# bonded or kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# A datagram is up to 1232 bytes: ask for the largest ATT MTU, so it takes 3 writes, not 62.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# The original ESP32's controller also does Classic: keep it to LE (the C3's is LE only).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
