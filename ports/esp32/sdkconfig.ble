# Bluetooth LE on NimBLE, for the `ble` feature (NB-110), on top of sdkconfig.defaults:
# LE only, no Classic and no Bluedroid. Peers authenticate with Noise IK, so nothing is
# bonded or kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# A datagram is up to 1232 bytes: an ATT MTU of 256 (docs/concepts/bluetooth.md) sends it in
# 5 writes, not 62, and costs less heap than 517.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# On by default for the C3 only: a connection that fails to establish (HCI 0x3E) is
# made again by NimBLE itself, with no event for the driver, so one that then comes up
# is a link nobody uses or closes; as a peripheral, it restarts advertising from
# NimBLE's own fields, not ours. The node tries again where it wants to.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
# Peers write one value at a time: no prepared (long) writes, so a central can't fill the
# stack's prepare queue before our callback runs (BLE-R7).
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=0
# Nothing asks for pairing (BLE-R5). The security manager stays in, Secure Connections too:
# esp32-nimble 0.13 doesn't build without the first, nor ESP-IDF 5.5.5 without the second.
# The firmware turns SC and bonding off at run time instead (src/ble.rs).
# No NimBLE host logs: a central nearby can make it log an error at will (a long write, say),
# and each line holds the console. src/ble.rs logs what the node needs to know.
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
# The original ESP32's controller also does Classic: keep it to LE (the C3's is LE only).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
# And no modem sleep (on by default on the ESP32, off on the C3): ESP-IDF's random numbers
# are true ones only while the radio is awake, and a node draws its keys with Wi-Fi off.
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
