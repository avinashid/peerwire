# Bluetooth LE on NimBLE, for the `ble` feature (NB-110), on top of sdkconfig.defaults:
# LE only, no Classic and no Bluedroid. Peers authenticate with Noise IK, so nothing is
# bonded or kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# A datagram is up to 1232 bytes: an ATT MTU of 256 (docs/concepts/bluetooth.md) sends it in
# 5 writes, not 62, and costs less heap than 517.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# Peers write one value at a time: no prepared (long) writes, so a central can't fill the
# stack's prepare queue before our callback runs (BLE-R7).
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=0
# Nothing asks for pairing (BLE-R5). The security manager stays in, Secure Connections too:
# esp32-nimble 0.13 doesn't build without the first, nor ESP-IDF 5.5.5 without the second.
# The firmware turns SC and bonding off at run time instead (see examples/ble_probe.rs).
# The original ESP32's controller also does Classic: keep it to LE (the C3's is LE only).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
