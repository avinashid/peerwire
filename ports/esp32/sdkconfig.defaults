# The node's loop runs on the main task: the handshake's curve math and the
# Node's buffers want more than the default 3 KB. The report logs the high-water mark.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
# std threads take this size: the Nostr relay thread's TLS handshake (NB-095) needs
# far more than 4 KB.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=32768
CONFIG_FREERTOS_HZ=1000

# QEMU's emulated Ethernet (the OpenCores MAC). A board would use Wi-Fi instead.
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_ETH_OPENETH_DMA_RX_BUFFER_NUM=4
CONFIG_ETH_OPENETH_DMA_TX_BUFFER_NUM=1
